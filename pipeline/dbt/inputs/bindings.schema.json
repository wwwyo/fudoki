{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fudoki.local/schemas/dbt-input-bindings-v1.json",
  "title": "dbt input table paths",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target": {
      "$ref": "https://fudoki.local/schemas/ingestion-manifest-v2.json#/$defs/target"
    },
    "direction": {
      "enum": [
        "expenditure",
        "revenue"
      ]
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table_id": {
            "$ref": "https://fudoki.local/schemas/ingestion-manifest-v2.json#/$defs/id"
          },
          "raw_path": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "table_id",
          "raw_path"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "target",
    "direction",
    "tables"
  ]
}
