{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fudoki.local/schemas/dbt-input-bindings-v1.json",
  "title": "dbt input paths and table meanings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target": {
      "$ref": "https://fudoki.local/schemas/ingestion-manifest-v2.json#/$defs/target"
    },
    "direction": {
      "enum": [
        "expenditure",
        "revenue"
      ]
    },
    "tables": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "table_id": {
            "$ref": "https://fudoki.local/schemas/ingestion-manifest-v2.json#/$defs/id"
          },
          "raw_path": {
            "type": "string",
            "minLength": 1
          },
          "declaration": {
            "$ref": "#/$defs/declaration"
          }
        },
        "required": [
          "table_id",
          "raw_path",
          "declaration"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "target",
    "direction",
    "tables"
  ],
  "$defs": {
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account": {},
        "account_partition": {},
        "additive": {},
        "additive_scope": {},
        "additive_within_own_grain": {},
        "amendment_number": {},
        "amount_kind": {},
        "approval": {},
        "approval_date": {},
        "approval_evidence": {},
        "approval_proof": {},
        "approval_sha256": {},
        "approval_status": {},
        "approval_url": {},
        "attribution": {},
        "baseline_status": {},
        "budget_columns_note": {},
        "canonical_changes": {},
        "canonical_executed": {},
        "canonical_initial": {},
        "composed_canonical_changes": {},
        "composition": {},
        "configured_attachment_pages": {},
        "council_resolution_date": {},
        "csv_layout": {},
        "dataset_title": {},
        "date_anomaly": {},
        "definition_files": {},
        "document_label": {},
        "document_title": {},
        "edition_status": {},
        "effective_at": {},
        "effective_at_basis": {},
        "effective_basis": {},
        "effective_date": {},
        "effective_date_basis": {},
        "encoding": {},
        "executive_disposition_date": {},
        "explanation_dataset_id": {},
        "explanation_statutory_correspondence": {},
        "extractor": {},
        "final_url": {},
        "financial_phase": {},
        "first_article_evidence": {},
        "fiscal_year_basis": {},
        "frozen_native_page_refs": {},
        "fund_basis": {},
        "fund_label": {},
        "grain": {},
        "immutable_raster_descriptor": {},
        "independent_breakdown": {},
        "landing_page": {},
        "layout": {},
        "legal_correspondence_status": {},
        "license_id": {},
        "namespace": {},
        "nonadditive": {},
        "nonadditive_reason": {},
        "nonadditive_with": {},
        "observation_role": {},
        "original_cover_approval_status": {},
        "original_identity_evidence": {},
        "original_observation_identity": {},
        "original_raw_row_identity": {},
        "original_source_table_id": {},
        "original_url": {},
        "pages": {},
        "phase": {},
        "phase_note": {},
        "phase_semantics": {},
        "phases": {},
        "printed_submission_date": {},
        "printed_total": {},
        "project_setsu_linkage": {},
        "raw_form": {},
