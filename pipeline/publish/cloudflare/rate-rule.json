{
  "ref": "fudoki_distribution_rate",
  "description": "Allow bulk fiscal downloads; bound repeated requests per IP",
  "expression": "(starts_with(http.request.uri.path, \"/fiscal/\"))",
  "action": "block",
  "enabled": true,
  "ratelimit": {
    "characteristics": [
      "cf.colo.id",
      "ip.src"
    ],
    "period": 10,
    "requests_per_period": 300,
    "mitigation_timeout": 10,
    "requests_to_origin": false
  }
}
