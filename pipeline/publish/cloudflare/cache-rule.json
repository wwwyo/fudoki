{
  "ref": "fudoki_distribution_cache",
  "description": "Immutable fiscal CSV and JSON",
  "expression": "(http.host eq \"download.fudoki.dev\" and starts_with(http.request.uri.path, \"/fiscal/\"))",
  "action": "set_cache_settings",
  "enabled": true,
  "action_parameters": {
    "cache": true,
    "edge_ttl": {
      "mode": "override_origin",
      "default": 31536000,
      "status_code_ttl": [
        {
          "status_code_range": {
            "from": 200,
            "to": 299
          },
          "value": 31536000
        },
        {
          "status_code": 304,
          "value": 31536000
        },
        {
          "status_code": 404,
          "value": -1
        },
        {
          "status_code_range": {
            "from": 500,
            "to": 599
          },
          "value": -1
        }
      ]
    },
    "browser_ttl": {
      "mode": "respect_origin"
    }
  }
}
