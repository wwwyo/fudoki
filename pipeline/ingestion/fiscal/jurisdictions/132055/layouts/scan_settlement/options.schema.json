{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Frozen observation settlement reconstruction options",
  "type": "object",
  "additionalProperties": false,
  "required": ["layout_path", "layout_sha256", "corrections_path", "corrections_sha256", "confirmations_path", "confirmations_sha256", "native_refs"],
  "properties": {
    "layout_path": {"type": "string", "minLength": 1},
    "layout_sha256": {"$ref": "#/$defs/sha"},
    "corrections_path": {"type": "string", "minLength": 1},
    "corrections_sha256": {"$ref": "#/$defs/sha"},
    "confirmations_path": {"type": "string", "minLength": 1},
    "confirmations_sha256": {"$ref": "#/$defs/sha"},
    "table_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
    "native_refs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "path", "sha256", "kind", "regions"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/sha"},
          "kind": {"enum": ["pdf", "image"]},
          "regions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "physical_page": {"type": "integer", "minimum": 1},
          "image_path": {"type": "string", "minLength": 1}
        },
        "allOf": [{"if": {"properties": {"kind": {"const": "image"}}}, "then": {"required": ["physical_page", "image_path"]}}]
      }
    }
  },
  "$defs": {"sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
