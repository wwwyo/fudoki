{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "table_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"},
    "account": {"type": "string", "minLength": 1},
    "summary_rows": {"type": "integer", "minimum": 1},
    "summary_pages": {"$ref": "#/$defs/ranges"},
    "detail_pages": {"$ref": "#/$defs/ranges"}
  },
  "required": ["table_id", "account", "summary_rows", "summary_pages", "detail_pages"],
  "$defs": {
    "ranges": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "array", "minItems": 2, "maxItems": 2,
        "items": {"type": "integer", "minimum": 1}
      }
    }
  }
}
