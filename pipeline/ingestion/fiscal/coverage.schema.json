{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fudoki.local/schemas/fiscal-coverage-v1.json",
  "title": "Fiscal source census v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "inspected_at": {
      "type": "string",
      "format": "date"
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "jurisdictions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "131016",
              "132047",
              "132071",
              "132195",
              "132241"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "search_boundaries": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "status": {
                  "enum": [
                    "inspected",
                    "fetch_failed",
                    "not_exhaustive"
                  ]
                },
                "inspected_at": {
                  "type": "string",
                  "format": "date"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                },
                "completion_proof": {
                  "$ref": "#/$defs/boundary_completion",
                  "description": "Optional evidence-backed closure of this finite boundary; inspected alone is not complete."
                }
              },
              "required": [
                "url",
                "status",
                "inspected_at",
                "note"
              ]
            }
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "phase": {
                  "enum": [
                    "initial",
                    "supplementary",
                    "settlement",
                    "all"
                  ]
                },
                "years": {
                  "type": "array",
                  "items": {
                    "type": "integer"
                  },
                  "uniqueItems": true
                },
                "account_scope": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "search_incomplete",
                    "content_unconfirmed",
                    "listed_download_failed",
                    "publisher_declares_unavailable"
                  ]
                },
                "detail": {
                  "type": "string",
                  "minLength": 1
                },
                "evidence_urls": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^https://"
                  }
                }
              },
              "required": [
                "phase",
                "years",
                "account_scope",
                "status",
                "detail",
                "evidence_urls"
              ]
            }
          }
        },
        "required": [
          "code",
          "name",
          "search_boundaries",
          "gaps"
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "jurisdiction": {
            "enum": [
              "131016",
              "132047",
              "132071",
              "132195",
              "132241"
            ]
          },
          "fiscal_year": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1900,
            "maximum": 2100
          },
          "document_phase": {
            "enum": [
              "initial",
              "supplementary",
              "settlement",
              "mixed"
            ]
          },
          "directions": {
            "type": "array",
            "items": {
              "enum": [
                "expenditure",
                "revenue"
              ]
            },
            "uniqueItems": true
          },
          "account_labels": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true,
            "description": "Original observed account cells. For CSV, only the jurisdiction-specific fiscal_code_style declaration may split a prefix; prefix2 separates exactly two code digits and preserves all remaining name digits."
          },
          "account_scope_status": {
            "enum": [
              "listed",
              "content_inspected",
              "unresolved"
            ]
          },
          "document_title": {
            "type": "string",
            "minLength": 1
          },
          "amendment_numbers": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "uniqueItems": true
          },
          "edition_status": {
            "enum": [
              "listed",
              "content_inspected",
              "unresolved"
            ]
          },
          "editions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "fiscal_year": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1900,
                  "maximum": 2100
                },
                "account_label": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Account name after explicitly declared source code/name separation; ambiguous raw code identities do not match an edition automatically."
                },
                "document_phase": {
                  "enum": [
                    "initial",
                    "supplementary",
                    "settlement"
                  ]
                },
                "amendment_number": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "basis": {
                  "type": "string",
                  "minLength": 1
                },
                "page": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "in_scope": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "status": {
                      "enum": [
                        "included",
                        "excluded",
                        "unconfirmed"
                      ]
                    },
                    "basis": {
                      "type": "string",
                      "minLength": 1
                    },
                    "evidence_urls": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^https://"
                      },
                      "uniqueItems": true
                    }
                  },
                  "required": [
                    "status",
                    "basis",
                    "evidence_urls"
                  ]
                },
                "content_confirmation": {
                  "$ref": "#/$defs/edition_confirmation",
                  "description": "Required by the completion gate for an expenditure edition, not for candidate registration; indices refer to content_inspection.evidence."
                },
                "content_grain": {
                  "$ref": "#/properties/sources/items/properties/content_grain",
                  "description": "Optional observed grain for this exact account/year/phase edition. It overrides the document-level grain only for this edition; other accounts remain independently checked."
                },
                "published_grain_exception": {
                  "$ref": "#/$defs/published_grain_exception",
                  "description": "Optional whole-original printed-absence proof; never confirms project×setsu and never waives search, approval, scope or output checks."
                }
              },
              "required": [
                "fiscal_year",
                "account_label",
                "document_phase",
                "amendment_number",
                "basis",
                "page",
                "in_scope"
              ]
            }
          },
          "role": {
            "enum": [
              "statement",
              "overview",
              "decision"
            ]
          },
          "format": {
            "enum": [
              "csv",
              "pdf"
            ]
          },
          "landing_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "download_url": {
            "type": "string",
            "pattern": "^https://"
          },
          "inspected_at": {
            "type": "string",
            "format": "date"
          },
          "listing_evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string"
              },
              "heading": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "label",
              "heading"
            ]
          },
          "content_inspection": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "not_inspected",
                  "text_probed",
                  "csv_inspected",
                  "image_only",
                  "fetch_or_decode_failed"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "page": {
                      "type": [
                        "integer",
                        "null"
                      ],
                      "minimum": 1
                    },
                    "kind": {
                      "type": "string",
                      "minLength": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "page",
                    "kind",
                    "text"
                  ]
                }
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "http_status": {
                "type": "integer"
              },
              "final_url": {
                "type": "string",
                "pattern": "^https://"
              },
              "header": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              },
              "rows": {
                "type": "integer",
                "minimum": 0
              },
              "pages": {
                "type": "integer",
                "minimum": 0
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "error": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "evidence"
            ]
          },
          "content_grain": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "unconfirmed",
                  "observed"
                ]
              },
              "observed_levels": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "Observed source terms; provided project paths are checked with canonical dbt levels jikou, saimoku, jigyo, daijigyo, chujigyo, shojigyo, rather than romanization aliases."
              },
              "project_setsu_relation": {
                "enum": [
                  "unconfirmed",
                  "confirmed_explicit",
                  "independent_breakdowns"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              },
              "relation_evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "status",
              "observed_levels",
              "project_setsu_relation",
              "note",
              "relation_evidence"
            ],
            "description": "Observed levels and relation evidence are necessary for completion. Independent Chiyoda moku/setsu side inputs are checked directly against adopted original/table/provenance hashes and their dedicated provided CSV, with same-edition explanation_dataset_id; they never certify a project×setsu correspondence."
          },
          "fixed_inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "origin_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "current_origin_match": {
                  "enum": [
                    "match",
                    "different",
                    "not_checked"
                  ]
                },
                "scope": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "origin_sha256",
                "current_origin_match",
                "scope"
              ]
            },
            "description": "Adopted input snapshot may include statement-moku-setsu/ independent side tables; their own IDs and original grain are checked directly rather than requiring int_fiscal_lines membership."
          },
          "marts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "not_checked",
                  "verified"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "status",
              "evidence"
            ]
          },
          "unresolved": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "in_scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "enum": [
                  "included",
                  "excluded",
                  "unconfirmed"
                ]
              },
              "basis": {
                "type": "string",
                "minLength": 1
              },
              "evidence_urls": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^https://"
                },
                "uniqueItems": true
              }
            },
            "required": [
              "status",
              "basis",
              "evidence_urls"
            ]
          },
          "unresolved_resolutions": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/unresolved_resolution"
            },
            "description": "One explicit resolution per exact unresolved item, with current lock/origin/output identities; never a blanket waiver."
          }
        },
        "required": [
          "id",
          "jurisdiction",
          "fiscal_year",
          "document_phase",
          "directions",
          "account_labels",
          "account_scope_status",
          "document_title",
          "amendment_numbers",
          "edition_status",
          "editions",
          "role",
          "format",
          "landing_url",
          "download_url",
          "inspected_at",
          "listing_evidence",
          "content_inspection",
          "content_grain",
          "fixed_inputs",
          "marts",
          "unresolved",
          "in_scope"
        ]
      }
    },
    "lock_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "entry_count": {
          "type": "integer",
          "minimum": 0
        },
        "matched_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "unmatched_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "lock_sha256",
        "entry_count",
        "matched_paths",
        "unmatched_paths"
      ]
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "inspected_at",
    "method",
    "jurisdictions",
    "sources",
    "lock_reconciliation"
  ],
  "$defs": {
    "indexed_original_evidence": {
      "type": "object",
      "properties": {
        "basis": {
          "type": "string",
          "minLength": 1
        },
        "evidence_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "required": [
        "basis",
        "evidence_indices"
      ]
    },
    "published_grain_exception": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": 1
        },
        "origin_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lock_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fiscal_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "account_label": {
          "type": "string",
          "minLength": 1
        },
        "document_phase": {
          "enum": [
            "initial",
            "supplementary",
            "settlement"
          ]
        },
        "amendment_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "whole_original_inspection": {
          "allOf": [
            {
              "$ref": "#/$defs/indexed_original_evidence"
            }
          ],
          "unevaluatedProperties": false,
          "properties": {
            "scope": {
              "const": "whole_original"
            },
            "independent_breakdowns_absent": {
              "const": true
            },
            "method": {
              "enum": [
                "csv_all_rows",
                "pdf_all_pages"
              ]
            },
            "row_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            },
            "page_count": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 1
            }
          },
          "required": [
            "scope",
            "independent_breakdowns_absent",
            "method",
            "row_count",
            "page_count"
          ]
        },
        "absent_dimensions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/indexed_original_evidence"
              }
            ],
            "unevaluatedProperties": false,
            "properties": {
              "dimension": {
                "enum": [
                  "project_setsu_relation",
                  "setsu"
                ]
              }
            },
            "required": [
              "dimension"
            ]
          }
        },
        "approval": {
          "allOf": [
            {
              "$ref": "#/$defs/indexed_original_evidence"
            }
          ],
          "unevaluatedProperties": false,
          "properties": {
            "status": {
              "const": "approved"
            }
          },
          "required": [
            "status"
          ]
        },
        "dataset_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "preservation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "allOf": [
              {
                "$ref": "#/$defs/indexed_original_evidence"
              }
            ],
            "unevaluatedProperties": false,
            "properties": {
              "dataset_id": {
                "type": "string",
                "minLength": 1
              },
              "fixed_input_path": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "const": "whole_expenditure_table"
              },
              "phase": {
                "enum": [
                  "approved",
                  "delta",
                  "executed"
                ]
              },
              "row_count": {
                "type": "integer",
                "minimum": 1
              },
              "source_row_column": {
                "type": [
                  "string",
                  "null"
                ],
                "minLength": 1
              },
              "account_column": {
                "type": "string",
                "minLength": 1
              },
              "amount_column": {
                "type": "string",
                "minLength": 1
              },
              "amount_unit": {
                "enum": [
                  "円",
                  "千円"
                ]
              },
              "moku_columns": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "project_columns": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "setsu_columns": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "statutory_setsu_code_column": {
                "type": "string",
                "minLength": 1
              },
              "row_exceptions": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/$defs/indexed_original_evidence"
                    }
                  ],
                  "unevaluatedProperties": false,
                  "properties": {
                    "source_row": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "role": {
                      "const": "printed_reserve"
                    },
                    "role_column": {
                      "type": "string",
                      "minLength": 1
                    },
                    "printed_setsu_evidence_indices": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  },
                  "required": [
                    "source_row",
                    "role",
                    "role_column",
                    "printed_setsu_evidence_indices"
                  ]
                }
              }
            },
            "required": [
              "dataset_id",
              "fixed_input_path",
              "scope",
              "phase",
              "row_count",
              "source_row_column",
              "account_column",
              "amount_column",
              "amount_unit",
              "moku_columns",
              "project_columns",
              "setsu_columns"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "origin_sha256",
        "lock_sha256",
        "fiscal_year",
        "account_label",
        "document_phase",
        "amendment_number",
        "whole_original_inspection",
        "absent_dimensions",
        "dataset_ids",
        "preservation"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "document_phase": {
                "const": "supplementary"
              }
            }
          },
          "then": {
            "required": [
              "approval"
            ]
          }
        }
      ]
    },
    "edition_confirmation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "origin_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "account_evidence_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "edition_evidence_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "direction_evidence_indices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "direction": {
          "const": "expenditure"
        }
      },
      "required": [
        "origin_sha256",
        "account_evidence_indices",
        "edition_evidence_indices",
        "direction_evidence_indices",
        "direction"
      ]
    },
    "search_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fiscal_year": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2100
        },
        "account_label": {
          "type": "string",
          "minLength": 1
        },
        "document_phase": {
          "enum": [
            "initial",
            "supplementary",
            "settlement"
          ]
        },
        "amendment_numbers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "last_amendment_number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "basis": {
          "type": "string",
