{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fudoki.local/schemas/ingestion-manifest-v1.json",
  "title": "Fiscal ingestion conversion plan and saved tables",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "direction": {
      "enum": [
        "expenditure",
        "revenue"
      ]
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "ready"
      ]
    },
    "conversions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conversion"
      },
      "minItems": 1
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "target",
    "direction",
    "candidate_id",
    "status",
    "conversions",
    "tables"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?:lib|fiscal)/(?!.*(?:\\.\\.|//|[\\\\%?#]))[a-zA-Z0-9_./-]+$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jurisdiction": {
              "type": "string",
              "pattern": "^[0-9]{6}$"
            },
            "fiscal_year": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2100
            },
            "document_kind": {
              "const": "initial"
            }
          },
          "required": [
            "jurisdiction",
            "fiscal_year",
            "document_kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jurisdiction": {
              "type": "string",
              "pattern": "^[0-9]{6}$"
            },
            "fiscal_year": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2100
            },
            "document_kind": {
              "const": "supplementary"
            },
            "amendment_number": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "jurisdiction",
            "fiscal_year",
            "document_kind",
            "amendment_number"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jurisdiction": {
              "type": "string",
              "pattern": "^[0-9]{6}$"
            },
            "fiscal_year": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2100
            },
            "document_kind": {
              "const": "settlement"
            }
          },
          "required": [
            "jurisdiction",
            "fiscal_year",
            "document_kind"
          ]
        }
      ]
    },
    "input": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "format": {
              "const": "pdf"
            },
            "scope": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "account": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pages": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "items": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "minItems": 1
                  }
                },
                "required": [
                  "account",
                  "pages"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "sha256",
            "format",
            "scope"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "format": {
              "const": "csv"
            },
            "scope": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "account": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "account"
                ]
              },
              "minItems": 1
            }
          },
          "required": [
            "sha256",
            "format",
            "scope"
          ]
        }
      ]
    },
    "expected_table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "table_id": {
          "$ref": "#/$defs/id"
        },
        "declaration": {
          "$ref": "#/$defs/declaration"
        },
        "legacy_path": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "table_id",
        "declaration"
      ]
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "converter": {
          "$ref": "#/$defs/path"
        },
        "options_schema": {
          "$ref": "#/$defs/path"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input"
          },
          "minItems": 1
        },
        "options": {
          "type": "object"
        },
        "expected_tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expected_table"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "converter",
        "options_schema",
        "dependencies",
        "inputs",
        "options",
        "expected_tables"
      ]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "table_id": {
          "$ref": "#/$defs/id"
        },
        "conversion_id": {
          "$ref": "#/$defs/id"
        },
        "input_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "object": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bucket": {
              "const": "fudoki-inputs"
            },
            "key": {
              "type": "string",
              "pattern": "^fiscal/ingestion/[0-9]{6}/[0-9]{4}/(?:initial|settlement|supplementary-[1-9][0-9]*)/(?:expenditure|revenue)/[a-z0-9][a-z0-9_-]{0,95}\\.parquet$"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "bucket",
            "key",
            "sha256",
            "bytes"
          ]
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "empty_confirmed": {
          "type": "boolean"
        },
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          },
          "minItems": 1
        },
        "origins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "sha256",
              "bytes"
            ]
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python": {
              "type": "string",
              "minLength": 1
            },
            "duckdb": {
              "type": "string",
              "minLength": 1
            },
            "os": {
              "type": "string",
              "minLength": 1
            },
            "os_build": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "python",
            "duckdb"
          ]
        }
      },
      "required": [
        "table_id",
        "conversion_id",
        "input_fingerprint",
        "object",
        "row_count",
        "empty_confirmed",
        "schema",
        "runtime",
        "origins"
      ]
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account": {},
        "account_partition": {},
        "additive": {},
        "additive_scope": {},
        "additive_within_own_grain": {},
        "amendment_number": {},
        "amount_kind": {},
        "approval": {},
        "approval_date": {},
        "approval_evidence": {},
        "approval_proof": {},
        "approval_sha256": {},
        "approval_status": {},
        "approval_url": {},
        "attribution": {},
        "baseline_status": {},
        "budget_columns_note": {},
        "canonical_changes": {},
        "canonical_executed": {},
        "canonical_initial": {},
        "composed_canonical_changes": {},
        "composition": {},
        "configured_attachment_pages": {},
        "council_resolution_date": {},
        "csv_layout": {},
        "dataset_title": {},
        "date_anomaly": {},
        "definition_files": {},
        "document_label": {},
        "document_title": {},
        "edition_status": {},
        "effective_at": {},
        "effective_at_basis": {},
        "effective_basis": {},
        "effective_date": {},
        "effective_date_basis": {},
        "encoding": {},
        "executive_disposition_date": {},
        "explanation_dataset_id": {},
        "explanation_statutory_correspondence": {},
        "extractor": {},
        "final_url": {},
        "financial_phase": {},
        "first_article_evidence": {},
        "fiscal_year_basis": {},
        "frozen_native_page_refs": {},
        "fund_basis": {},
        "fund_label": {},
        "grain": {},
        "immutable_raster_descriptor": {},
        "independent_breakdown": {},
        "landing_page": {},
        "layout": {},
        "legal_correspondence_status": {},
        "license_id": {},
        "namespace": {},
        "nonadditive": {},
        "nonadditive_reason": {},
        "nonadditive_with": {},
        "observation_role": {},
        "original_cover_approval_status": {},
        "original_identity_evidence": {},
        "original_observation_identity": {},
        "original_raw_row_identity": {},
        "original_source_table_id": {},
        "original_url": {},
        "pages": {},
        "phase": {},
        "phase_note": {},
        "phase_semantics": {},
        "phases": {},
        "printed_submission_date": {},
        "printed_total": {},
        "project_setsu_linkage": {},
        "raw_form": {},
        "recognition_basis": {},
        "recognition_proof": {},
        "recognition_status": {},
        "redistribute": {},
        "redistribute_basis": {},
        "request_url": {},
        "resource_name": {},
        "resource_url_basis": {},
        "resource_url_declared": {},
        "sign_note": {},
        "source_amount_kind": {},
        "source_amount_unit": {},
        "source_grain": {},
        "source_key": {},
        "source_manifest_sha256": {},
        "source_page_range": {},
        "source_position_method": {},
        "source_spec_bytes": {},
        "source_spec_sha256": {},
        "source_url": {},
        "statutory_correspondence_status": {},
        "submitted_date": {},
        "table_id": {},
        "totals": {},
        "unit_multiplier": {},
        "url_basis": {},
        "visual_ledger_file": {},
        "year_basis": {}
      }
    }
  }
}
