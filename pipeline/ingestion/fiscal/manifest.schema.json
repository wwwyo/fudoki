{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fudoki.local/schemas/ingestion-manifest-v2.json",
  "title": "Fiscal ingestion conversion plan and saved tables",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "target": {
      "$ref": "#/$defs/target"
    },
    "direction": {
      "enum": [
        "expenditure",
        "revenue"
      ]
    },
    "candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "planned",
        "ready"
      ]
    },
    "conversions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conversion"
      },
      "minItems": 1
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "target",
    "direction",
    "candidate_id",
    "status",
    "conversions",
    "tables"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,95}$"
    },
    "path": {
      "type": "string",
      "pattern": "^(?:lib|fiscal)/(?!.*(?:\\.\\.|//|[\\\\%?#]))[a-zA-Z0-9_./-]+$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jurisdiction": {
              "type": "string",
              "pattern": "^[0-9]{6}$"
            },
            "fiscal_year": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2100
            },
            "document_kind": {
              "const": "initial"
            }
          },
          "required": [
            "jurisdiction",
            "fiscal_year",
            "document_kind"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jurisdiction": {
              "type": "string",
              "pattern": "^[0-9]{6}$"
            },
            "fiscal_year": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2100
            },
            "document_kind": {
              "const": "supplementary"
            },
            "amendment_number": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "jurisdiction",
            "fiscal_year",
            "document_kind",
            "amendment_number"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jurisdiction": {
              "type": "string",
              "pattern": "^[0-9]{6}$"
            },
            "fiscal_year": {
              "type": "integer",
              "minimum": 1900,
              "maximum": 2100
            },
            "document_kind": {
              "const": "settlement"
            }
          },
          "required": [
            "jurisdiction",
            "fiscal_year",
            "document_kind"
          ]
        }
      ]
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "sha256"
      ]
    },
    "expected_table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "table_id": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "table_id"
      ]
    },
    "conversion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "converter": {
          "$ref": "#/$defs/path"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/input"
          },
          "minItems": 1
        },
        "options": {
          "type": "object"
        },
        "expected_tables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/expected_table"
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "converter",
        "inputs",
        "options",
        "expected_tables"
      ]
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "type"
      ]
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "table_id": {
          "$ref": "#/$defs/id"
        },
        "conversion_id": {
          "$ref": "#/$defs/id"
        },
        "input_fingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "object": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "bucket": {
              "const": "fudoki-inputs"
            },
            "key": {
              "type": "string",
              "pattern": "^fiscal/ingestion/[0-9]{6}/[0-9]{4}/(?:initial|settlement|supplementary-[1-9][0-9]*)/(?:expenditure|revenue)/[a-z0-9][a-z0-9_-]{0,95}\\.parquet$"
            },
            "sha256": {
              "$ref": "#/$defs/sha256"
            },
            "bytes": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "bucket",
            "key",
            "sha256",
            "bytes"
          ]
        },
        "row_count": {
          "type": "integer",
          "minimum": 0
        },
        "empty_confirmed": {
          "type": "boolean"
        },
        "schema": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          },
          "minItems": 1
        },
        "origins": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "bytes": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "sha256",
              "bytes"
            ]
          }
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "python": {
              "type": "string",
              "minLength": 1
            },
            "duckdb": {
              "type": "string",
              "minLength": 1
            },
            "os": {
              "type": "string",
              "minLength": 1
            },
            "os_build": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "python",
            "duckdb"
          ]
        }
      },
      "required": [
        "table_id",
        "conversion_id",
        "input_fingerprint",
        "object",
        "row_count",
        "empty_confirmed",
        "schema",
        "runtime",
        "origins"
      ]
    }
  }
}
