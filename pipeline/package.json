{
  "name": "@fudoki/pipeline",
  "private": true,
  "type": "module",
  "scripts": {
    "acquire": "uv run python -m ingestion.acquire",
    "build": "bun run build.ts",
    "coverage:fiscal": "uv run python -m ingestion.fiscal.coverage_audit",
    "eval:extraction": "uv run python -m ingestion.fiscal.eval_extraction",
    "extract:budget-history": "uv run python -m ingestion.fiscal.extract_budget_history",
    "extract:projects": "uv run python -m ingestion.fiscal.extract_projects",
    "extract:revenue-accounts": "uv run python -m ingestion.fiscal.extract_revenue_accounts",
    "extract:statements": "uv run python -m ingestion.fiscal.extract_statement",
    "fdp": "uv run python -m fdp.build",
    "fetch:account-master": "uv run python -m ingestion.fiscal.fetch_account_master",
    "fetch:fdp-taxonomy": "bun run fdp/fetch-taxonomy.ts",
    "inputs": "uv run python -m ingestion.inputs restore --remote",
    "inputs:migrate": "uv run python -m ingestion.inputs migrate",
    "pdf:layer": "uv run python -m ingestion.fiscal.pdf_layer",
    "sources:plan": "uv run python -m ingestion.fiscal.source_registry",
    "survey:structure": "uv run python -m ingestion.fiscal.survey_structure",
    "test": "bun test artifacts.test.ts source_selection",
    "test:python": "uv run python -m unittest discover -s . -p '*_test.py'"
  },
  "dependencies": {
    "@fudoki/fiscal": "workspace:*",
    "@fudoki/jurisdictions": "workspace:*",
    "zod": "catalog:"
  }
}
