{
  "name": "@fudoki/pipeline",
  "private": true,
  "type": "module",
  "scripts": {
    "acquire": "uv run python -m ingestion.acquire",
    "build": "bun run build.ts",
    "dbt:inputs:check": "uv run python -m dbt_inputs check",
    "eval:extraction": "uv run python -m ingestion.fiscal.management.eval_extraction",
    "extract:budget-history": "uv run python -m ingestion.fiscal.layouts.fiscal_general.extract_budget_history",
    "extract:projects": "uv run python -m ingestion.fiscal.layouts.fiscal_general.extract_projects",
    "extract:revenue-accounts": "uv run python -m ingestion.fiscal.layouts.fiscal_general.extract_revenue_accounts",
    "extract:statements": "uv run python -m ingestion.fiscal.layouts.fiscal_general.extract_statement",
    "fdp": "uv run python -m fdp.build",
    "fetch:account-master": "uv run python -m ingestion.fiscal.management.fetch_account_master",
    "fetch:fdp-taxonomy": "bun run fdp/fetch-taxonomy.ts",
    "inputs": "uv run python -m build_inputs restore --remote",
    "inputs:migrate": "uv run python -m ingestion.inputs migrate",
    "pdf:layer": "uv run python -m ingestion.fiscal.layouts.fiscal_general.pdf_layer",
    "sources:plan": "uv run python -m ingestion.fiscal.management.source_registry",
    "survey:structure": "uv run python -m ingestion.fiscal.management.survey_structure",
    "test": "bun test artifacts.test.ts source_selection ingestion/selection.test.ts",
    "test:python": "uv run python -m unittest discover -s . -p '*_test.py'",
    "ingestion:schema": "uv run python -m ingestion.fiscal.run schema",
    "ingestion:check": "uv run python -m ingestion.fiscal.run check",
    "ingestion:convert": "uv run python -m ingestion.fiscal.run convert",
    "ingestion:restore": "uv run python -m ingestion.fiscal.run restore",
    "ingestion:cleanup": "uv run python -m ingestion.fiscal.run cleanup",
    "ingestion:migrate": "uv run python -m ingestion.fiscal.migrate",
    "ingestion:originals": "uv run python -m ingestion.fiscal.run originals"
  },
  "dependencies": {
    "@fudoki/fiscal": "workspace:*",
    "@fudoki/jurisdictions": "workspace:*",
    "zod": "catalog:"
  }
}
