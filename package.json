{
  "name": "fudoki",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "pipeline",
      "pipeline/verify/report",
      "pipeline/verify/view",
      "apps/web/deploy"
    ],
    "catalog": {
      "@types/bun": "1.3.14",
      "typescript": "7.0.2",
      "wrangler": "4.137.0",
      "zod": "4.4.3",
      "@cloudflare/config": "0.17.0"
    }
  },
  "scripts": {
    "build:api": "bun run --cwd apps/api build",
    "build:docs": "bun run --cwd apps/docs build",
    "build:web": "bun run --cwd apps/web build",
    "deploy:api": "bun run --cwd apps/api deploy",
    "deploy:docs": "bun run --cwd apps/docs deploy",
    "deploy:web": "bun run --cwd apps/web deploy",
    "dev": "bun run pipeline:report && bun run --cwd pipeline/verify/view dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "pipeline": "bun run --cwd pipeline acquire && bun run pipeline:build && bun run pipeline:report",
    "pipeline:build": "bun run --cwd pipeline build",
    "pipeline:fdp": "bun run --cwd pipeline fdp",
    "pipeline:inputs": "bun run --cwd pipeline inputs",
    "pipeline:migrate": "bun run --cwd pipeline inputs:migrate",
    "pipeline:report": "bun run --cwd pipeline/verify/report build",
    "report": "bun run pipeline:report",
    "test": "bun test apps/availability.test.ts && bun run --filter '@fudoki/*' test",
    "test:e2e": "bun run typecheck:e2e && E2E_TELEMETRY_DISABLED=1 mise x -- bun run e2e run",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "bun run typecheck && bun run --filter '@fudoki/*' typecheck",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "3.0.62",
    "@e2e-dev/web": "0.11.2",
    "@types/bun": "catalog:",
    "ai": "7.0.127",
    "e2e": "0.16.0",
    "playwright": "1.63.0",
    "typescript": "catalog:"
  }
}
