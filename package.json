{
  "name": "fudoki",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "pipeline",
      "pipeline/publish",
      "pipeline/verify/report",
      "pipeline/verify/view",
      "slides",
      "apps/web/deploy"
    ],
    "catalog": {
      "@types/bun": "1.3.14",
      "typescript": "7.0.2",
      "wrangler": "4.137.0",
      "zod": "4.4.3",
      "@cloudflare/config": "0.17.0"
    }
  },
  "scripts": {
    "build:api": "bun run --cwd apps/api build",
    "build:brand": "uv run --no-project --with fonttools python apps/web/brand/build.py",
    "build:docs": "bun run --cwd apps/docs build",
    "build:download": "bun run --cwd apps/download build",
    "build:verification": "bun run pipeline/publish/build.ts",
    "build:web": "bun run --cwd apps/web build",
    "check:bulletins": "bun run pipeline/ingestion/transcripts/check-bulletins.ts",
    "check:fiscal": "uv run python -m ingestion.fiscal.check_granularity",
    "coverage:sources": "uv run python -m ingestion.fiscal.source_coverage",
    "deploy:api": "bun run --cwd apps/api deploy",
    "deploy:docs": "bun run --cwd apps/docs deploy",
    "deploy:download": "bun run --cwd apps/download deploy",
    "deploy:verification": "bun run pipeline/publish/build.ts --deploy",
    "deploy:web": "bun run --cwd apps/web deploy",
    "dev": "bun run pipeline:report && bun run --cwd pipeline/verify/view dev",
    "dev:api": "bun run --cwd apps/api dev",
    "dev:download": "bun run --cwd apps/download dev",
    "dev:setup": "bun run pipeline/verify/setup-dev.ts",
    "dev:web": "bun run --cwd apps/web dev",
    "eval:extraction": "uv run python -m ingestion.fiscal.eval_extraction",
    "extract:projects": "uv run python -m ingestion.fiscal.extract_projects",
    "extract:revenue-accounts": "uv run python -m ingestion.fiscal.extract_revenue_accounts",
    "extract:statements": "uv run python -m ingestion.fiscal.extract_statement",
    "fetch:account-master": "uv run python -m ingestion.fiscal.fetch_account_master",
    "fetch:boundaries": "uv run python apps/web/map/build.py",
    "fetch:fdp-taxonomy": "bun run pipeline/fdp/fetch-taxonomy.ts",
    "fetch:robots": "bun run pipeline/ingestion/transcripts/fetch-robots.ts",
    "pdf:layer": "uv run python -m ingestion.fiscal.pdf_layer",
    "pipeline": "uv run python -m ingestion.acquire && bun run pipeline:build && bun run pipeline:report",
    "pipeline:build": "bun run pipeline/build.ts",
    "pipeline:inputs": "uv run python -m ingestion.inputs restore --remote",
    "pipeline:migrate": "uv run python -m ingestion.inputs migrate",
    "pipeline:publish": "bun run pipeline/publish/cli.ts",
    "pipeline:report": "bun run pipeline/verify/report/fiscal/build.ts",
    "probe:documents": "uv run python -m ingestion.fiscal.probe_documents",
    "survey:fiscal-years": "uv run python -m ingestion.fiscal.survey_years",
    "survey:structure": "uv run python -m ingestion.fiscal.survey_structure",
    "test": "bun test packages pipeline/release.test.ts pipeline/fdp pipeline/publish pipeline/verify/report apps/api/src apps/download/src apps/web/src pipeline/verify/view/src",
    "test:api": "bun run --cwd apps/api test",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "bun run typecheck && bun run --cwd apps/api typecheck && bun run --cwd apps/download typecheck && bun run --cwd apps/web typecheck && bun run --cwd pipeline/verify/view typecheck && bun run --cwd apps/docs typecheck",
    "validate": "bun run pipeline/ingestion/transcripts/validate.ts",
    "report": "bun run pipeline:report",
    "dev:setup:download": "bun run pipeline/verify/setup-download.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
