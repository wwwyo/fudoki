{
  "name": "fudoki",
  "private": true,
  "type": "module",
  "scripts": {
    "build:web": "bun run report && bun run --cwd web build",
    "check:budget": "bun run ingestion/budget/check-granularity.ts",
    "check:bulletins": "bun run ingestion/transcripts/check-bulletins.ts",
    "dbt": "cd dbt && DBT_PROFILES_DIR=. uv run dbt build",
    "dev": "bun run report && bun run --cwd web dev",
    "extract:projects": "uv run python -m ingestion.budget.extract_projects",
    "fetch:fdp-taxonomy": "bun run fdp/fetch-taxonomy.ts",
    "fetch:robots": "bun run ingestion/transcripts/fetch-robots.ts",
    "pipeline": "uv run python -m ingestion.budget.fetch && uv run python -m ingestion.budget.extract_projects && bun run dbt && uv run python -m fdp.build && bun run report",
    "report": "bun run report/budget/build.ts",
    "survey:budget-years": "uv run python -m ingestion.budget.survey_years",
    "survey:structure": "uv run python -m ingestion.budget.survey_structure",
    "typecheck": "tsc --noEmit",
    "validate": "bun run ingestion/transcripts/validate.ts"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "7.0.2"
  }
}
