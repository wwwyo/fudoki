{
  "name": "fudoki",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "report"
    ],
    "catalog": {
      "@types/bun": "1.3.14",
      "typescript": "7.0.2",
      "wrangler": "4.123.0",
      "zod": "4.4.3"
    }
  },
  "scripts": {
    "build:api": "bun run --cwd apps/api build",
    "build:brand": "uv run --no-project --with fonttools python apps/web/brand/build.py",
    "build:docs": "bun run --cwd apps/docs build",
    "build:web": "bun run report && bun run --cwd apps/web build",
    "check:budget": "uv run python -m ingestion.budget.check_granularity",
    "check:bulletins": "bun run ingestion/transcripts/check-bulletins.ts",
    "coverage:sources": "uv run python -m ingestion.budget.source_coverage",
    "dbt": "cd dbt && DBT_PROFILES_DIR=. uv run dbt build",
    "deploy:api": "bun run dbt && uv run python -m fdp.build && bun run --cwd apps/api deploy",
    "deploy:docs": "bun run --cwd apps/docs deploy",
    "deploy:web": "bun run dbt && bun run build:web && bun run --cwd apps/web deploy",
    "dev": "bun run report && bun run --cwd apps/web dev",
    "eval:extraction": "uv run python -m ingestion.budget.eval_extraction",
    "extract:projects": "uv run python -m ingestion.budget.extract_projects",
    "extract:revenue-accounts": "uv run python -m ingestion.budget.extract_revenue_accounts",
    "extract:statements": "uv run python -m ingestion.budget.extract_statement",
    "fetch:account-master": "uv run python -m ingestion.budget.fetch_account_master",
    "fetch:boundaries": "uv run python apps/web/map/build.py",
    "fetch:fdp-taxonomy": "bun run fdp/fetch-taxonomy.ts",
    "fetch:robots": "bun run ingestion/transcripts/fetch-robots.ts",
    "pipeline": "uv run python -m ingestion.budget.fetch && uv run python -m ingestion.budget.extract_projects && uv run python -m ingestion.budget.extract_revenue_accounts && uv run python -m ingestion.budget.extract_statement && bun run dbt && uv run python -m fdp.build && bun run report",
    "probe:documents": "uv run python -m ingestion.budget.probe_documents",
    "report": "bun run report/budget/build.ts",
    "survey:budget-years": "uv run python -m ingestion.budget.survey_years",
    "survey:structure": "uv run python -m ingestion.budget.survey_structure",
    "test:api": "bun run --cwd apps/api test",
    "typecheck": "tsc --noEmit",
    "validate": "bun run ingestion/transcripts/validate.ts"
  },
  "dependencies": {
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
